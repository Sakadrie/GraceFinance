/**
 * APPLICATION: Gestion Financière d'Église (Norme SYSCOHADA)
 * Version: 1.0
 */

entity EntiteFinanciere {
  nom String required,
  code String required unique,
  type String required,
  description String,
  actif Boolean required
}

entity Caisse {
  nom String required,
  code String required,
  type String required,
  devise String required,
  solde BigDecimal required,
  actif Boolean required
}

entity Categorie {
  nom String required,
  code String required,
  typeCategorie String required,
  description String,
  actif Boolean required
}

entity Recette {
  code String required,
  dateRecette LocalDate required,
  montant BigDecimal required,
  typeRecette String required,
  anonyme Boolean required,
  membreNom String,
  motif String,
  referencePiece String,
  statut String required
}

entity Depense {
  code String required,
  dateDepense LocalDate required,
  montant BigDecimal required,
  motif String required,
  referencePiece String,
  statut String required,
  validerPar String,
  dateValidation Instant
}

entity Transfert {
  code String required,
  dateTransfert LocalDate required,
  montant BigDecimal required,
  motif String,
  typeTransfert String required,
  statut String required,
  validerPar String,
  dateValidation Instant
}

entity Droit {
  nom String required,
  code String required unique,
  description String
}

entity Profil {
  nom String required,
  code String required unique,
  description String
}

entity AffectationUtilisateur {
  actif Boolean required,
  dateAffectation LocalDate required
}

entity CompteComptable {
  code String required,
  libelle String required,
  classe Integer required
}

entity EcritureComptable {
  dateComptable LocalDate required,
  numeroPiece String required,
  libelle String,
  referenceExterne String
}

entity LigneEcriture {
  montant BigDecimal required,
  sens String required,
  libelle String
}

// ==========================================
// RELATIONS
// ==========================================

relationship ManyToOne {
  Caisse{entiteFinanciere required} to EntiteFinanciere,

  Categorie{entiteFinanciere required} to EntiteFinanciere,

  Recette{entiteFinanciere required} to EntiteFinanciere,
  Recette{caisse required} to Caisse,
  Recette{categorie required} to Categorie,

  Depense{entiteFinanciere required} to EntiteFinanciere,
  Depense{caisse required} to Caisse,
  Depense{categorie required} to Categorie,

  Transfert{entiteFinanciereSource required} to EntiteFinanciere,
  Transfert{caisseSource required} to Caisse,
  Transfert{caisseDestination required} to Caisse,

  AffectationUtilisateur{user required} to User with builtInEntity,
  AffectationUtilisateur{entiteFinanciere required} to EntiteFinanciere,

  LigneEcriture{ecriture required} to EcritureComptable,
  LigneEcriture{compte required} to CompteComptable
}

relationship ManyToMany {
  EntiteFinanciere{egliseLiee} to EntiteFinanciere{structureLiee},
  Profil{droit} to Droit{profil},
  AffectationUtilisateur{profil} to Profil{affectation}
}

// ==========================================
// CONFIGURATION TECHNIQUE
// ==========================================

filter Recette, Depense, Transfert, AffectationUtilisateur, Caisse, Categorie, EcritureComptable, LigneEcriture, CompteComptable

paginate * with pagination
service * with serviceImpl
dto * with mapstruct